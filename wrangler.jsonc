{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noisy-virus",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  // static files are served before the Worker runs; unmatched requests
  // (/api/*) fall through to worker.js via the ASSETS binding fallback
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
